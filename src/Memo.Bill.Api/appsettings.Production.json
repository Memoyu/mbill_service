{
  "ConnectionStrings": {
    "MySql": "{mysql-conn}",
    "Redis": "{redis-conn}"
  },
  "Mongo": {
    "ConnectionString": "mongodb://{mongodb-conn}",
    "Database": "memo_bill"
  },
  "CorsOrigins": "http://demo.com,http://localhost:11011,http://localhost:11012",

  "Authorization": {
    "Jwt": {
      "Secret": "{jwt-secret}",
      "Issuer": "memoyu",
      "Audience": "memo.bill",
      "ExpiryInMin": 720
    },
    "Qiniu": {
      "AK": "{qiniu-ak}",
      "SK": "{qiniu-sk}",
      "Bucket": "mbill",
      "Host": "https://oss.memoyu.com/",
      "UseHttps": true
    },
    "Amap": {
      "Key": "{amap-key}"
    },
    "MiniProgram": {
      "AppId": "{mp-app-id}",
      "AppSecret": "{mp-app-secret}"
    }
  }
}
